{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "doctrine/collections": "^2.6",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "doctrine/persistence": "^4.1",
        "elasticsearch/elasticsearch": "^9.5",
        "gedmo/doctrine-extensions": "^3.22",
        "knplabs/knp-components": "^5.2",
        "knplabs/knp-paginator-bundle": "^6.10",
        "phpoffice/phpspreadsheet": "^5.7",
        "scienta/doctrine-json-functions": "^6.5",
        "stof/doctrine-extensions-bundle": "^1.15",
        "symfony/amqp-messenger": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-bridge": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/options-resolver": "7.4.*",
        "symfony/password-hasher": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-core": "7.4.*",
        "symfony/security-http": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/webpack-encore-bundle": "^2.2",
        "symfony/yaml": "7.4.*",
        "symfonycasts/verify-email-bundle": "^1.18",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "maglnet/composer-require-checker": "^4.17",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.8",
        "squizlabs/php_codesniffer": "^3.13",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/maker-bundle": "^1.65",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "check": [
            "@check:lint",
            "@check:cs",
            "@check:phpcs",
            "@check:phpstan",
            "@check:deptrac",
            "@check:rector",
            "@check:composer"
        ],
        "check:lint": [
            "@php bin/console lint:container",
            "@php bin/console lint:twig templates",
            "@php bin/console lint:yaml config --parse-tags"
        ],
        "check:cs": "@php vendor/bin/php-cs-fixer fix --dry-run --diff --using-cache=no",
        "check:phpcs": "@php vendor/bin/phpcs --runtime-set ignore_warnings_on_exit 1",
        "check:phpstan": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check:deptrac": "@php vendor/bin/deptrac analyse --no-progress",
        "check:rector": "@php vendor/bin/rector process --dry-run --no-progress-bar",
        "check:composer": "@php vendor/bin/composer-require-checker check composer.json",
        "check:schema": [
            "@php bin/console doctrine:schema:validate",
            "@php bin/console doctrine:migrations:up-to-date"
        ]
    },
    "scripts-descriptions": {
        "check": "Run all static analysis checks",
        "check:lint": "Symfony linters (container, twig, yaml)",
        "check:cs": "PHP-CS-Fixer coding style check (dry-run)",
        "check:phpcs": "PHP_CodeSniffer rules from phpcs.xml.dist",
        "check:phpstan": "PHPStan static analysis",
        "check:deptrac": "Deptrac layer dependency rules",
        "check:rector": "Rector refactoring suggestions (dry-run)",
        "check:composer": "composer-require-checker: used symbols must be declared dependencies",
        "check:schema": "Doctrine mapping and migrations check (needs a database)"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
