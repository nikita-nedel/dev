{% extends 'base.html.twig' %}

{% block title %}Мои заказы — WB Style{% endblock %}

{% block body %}
    <div class="wb-page-head">
        <div class="container">
            <nav class="wb-breadcrumbs" aria-label="Хлебные крошки">
                <a href="{{ path('app_home') }}">Главная</a>
                <span class="sep">/</span>
                <a href="{{ path('app_profile') }}">Личный кабинет</a>
                <span class="sep">/</span>
                <span aria-current="page">Заказы</span>
            </nav>
            <div class="wb-page-title-row">
                <div>
                    <h1>Мои заказы</h1>
                    <p>Следите за доставкой, повторяйте покупки и оставляйте отзывы в одном месте.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="simple-page">
        <div class="container">
            <div class="orders-tabs" role="group" aria-label="Фильтр заказов">
                <button class="profile-tab is-active" type="button" data-order-filter="all">Все</button>
                <button class="profile-tab" type="button" data-order-filter="shipping">В пути</button>
                <button class="profile-tab" type="button" data-order-filter="done">Получены</button>
                <button class="profile-tab" type="button" data-order-filter="returns">Возвраты</button>
            </div>

            <div class="orders-grid">
                {% for order in orders %}
                    <article class="order-block" data-status="{{ order.statusType }}">
                        <div class="order-block__head">
                            <div>
                                <div class="order-block__number">Заказ {{ order.number }}</div>
                                <div class="order-block__date">{{ order.date|date('d.m.Y') }}</div>
                            </div>
                            <span class="order-block__status {{ order.statusType == 'shipping' ? 'order-status--transit' : 'order-status--done' }}">{{ order.status }}</span>
                        </div>

                        <div class="order-products">
                            {% for product in order.products %}
                                <a class="order-product" href="{{ path('app_product_show', {id: product.id}) }}">
                                    <img src="{{ product.image }}" alt="{{ product.name }}">
                                    <span>
                                        <span class="order-product__name">{{ product.name }}</span>
                                        <span class="order-product__price">{{ product.price|number_format(0, ',', ' ') }} ₽</span>
                                    </span>
                                </a>
                            {% endfor %}
                        </div>

                        <div class="order-steps">
                            {% for step in order.steps %}
                                <div class="order-step {{ loop.index <= order.activeStep ? 'is-active' : '' }}">{{ step }}</div>
                            {% endfor %}
                        </div>

                        <div class="order-block__foot">
                            <div class="order-block__address"><i class="bi bi-geo-alt me-1"></i>{{ order.address }}</div>
                            <div class="order-block__total">{{ order.total|number_format(0, ',', ' ') }} ₽</div>
                        </div>

                        <div class="order-block__actions">
                            <a class="btn btn-primary btn-sm" href="{{ path('cart') }}">Повторить заказ</a>
                            <button class="btn btn-outline-primary btn-sm" type="button" data-wb-demo="Детали заказа">Подробнее</button>
                            {% if order.statusType == 'done' %}
                                <button class="btn btn-outline-primary btn-sm" type="button" data-wb-demo="Отзыв на заказ">Оставить отзыв</button>
                            {% endif %}
                        </div>
                    </article>
                {% else %}
                    <div class="wb-empty">
                        <span class="wb-empty__icon"><i class="bi bi-box-seam"></i></span>
                        <h2>Заказов пока нет</h2>
                        <p>Начните с подборки хитов или откройте каталог.</p>
                        <a class="btn btn-primary" href="{{ path('cat') }}">В каталог</a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{% block extra_javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tabs = [...document.querySelectorAll('[data-order-filter]')];
            const orders = [...document.querySelectorAll('.order-block')];
            tabs.forEach((tab) => {
                tab.addEventListener('click', () => {
                    tabs.forEach((item) => item.classList.toggle('is-active', item === tab));
                    const filter = tab.dataset.orderFilter;
                    orders.forEach((order) => {
                        order.hidden = filter !== 'all' && order.dataset.status !== filter;
                    });
                });
            });
        });
    </script>
{% endblock %}
