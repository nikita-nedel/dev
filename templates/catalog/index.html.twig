{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} — WB Style{% endblock %}

{% block body %}
    <div class="catalog-page">
        <div class="container">
            <div class="wb-page-head">
                <nav class="wb-breadcrumbs" aria-label="Хлебные крошки">
                    <a href="{{ path('app_home') }}">Главная</a>
                    <span class="sep">/</span>
                    <a href="{{ path('cat') }}">Каталог</a>
                    <span class="sep">/</span>
                    <span aria-current="page">{{ category.name }}</span>
                </nav>
            </div>

            <div class="catalog-hero">
                <div>
                    <h1>{{ category.name }}</h1>
                    <p>{{ category.description }}</p>
                    <div class="catalog-hero__stats">
                        <div class="catalog-stat"><strong>{{ category.productCount|number_format(0, ',', ' ') }}</strong><span>товаров</span></div>
                        <div class="catalog-stat"><strong>{{ category.avgRating }}</strong><span>средний рейтинг</span></div>
                        <div class="catalog-stat"><strong>до −{{ category.maxDiscount }}%</strong><span>максимальная скидка</span></div>
                    </div>
                </div>
                <div class="category-chips" aria-label="Разделы каталога">
                    {% for catalogCategory in categories %}
                        <a class="category-chip {{ catalogCategory.slug == category.slug ? 'is-active' : '' }}"
                           href="{{ path('cat', {slug: catalogCategory.slug}) }}">{{ catalogCategory.name }}</a>
                    {% endfor %}
                </div>
            </div>

            <div class="catalog-layout">
                <aside class="filters-panel" aria-label="Фильтры">
                    <div class="filters-panel__head">
                        <strong>Фильтры</strong>
                        <button type="button" data-wb-demo="Сброс фильтров">Сбросить</button>
                    </div>

                    <details class="filter-group" open>
                        <summary>Цена, ₽</summary>
                        <div class="filter-group__body">
                            <div class="price-inputs">
                                <input type="number" placeholder="0" min="0" max="100000" value="0" aria-label="Цена от">
                                <span>—</span>
                                <input type="number" placeholder="100000" min="0" max="100000" value="50000" aria-label="Цена до">
                            </div>
                        </div>
                    </details>

                    <details class="filter-group" open>
                        <summary>Бренды</summary>
                        <div class="filter-group__body">
                            {% for brand in brands %}
                                <label class="filter-check">
                                    <input type="checkbox" name="brand[]" value="{{ brand.id }}">
                                    <span>{{ brand.name }}</span>
                                    <span>{{ brand.count }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </details>

                    <details class="filter-group" open>
                        <summary>Размеры</summary>
                        <div class="filter-group__body">
                            <div class="size-chip-grid">
                                {% for size in sizes %}
                                    <button class="size-chip" type="button" data-wb-demo="Размер {{ size }}">{{ size }}</button>
                                {% endfor %}
                            </div>
                        </div>
                    </details>

                    <details class="filter-group">
                        <summary>Цвета</summary>
                        <div class="filter-group__body">
                            <div class="color-chip-row">
                                {% for color in colors %}
                                    <button class="color-chip" type="button" style="background-color: {{ color.code }};" title="{{ color.name }}" aria-label="{{ color.name }}" data-wb-demo="Цвет: {{ color.name }}"></button>
                                {% endfor %}
                            </div>
                        </div>
                    </details>

                    <details class="filter-group">
                        <summary>Доставка</summary>
                        <div class="filter-group__body">
                            <label class="filter-check"><input type="checkbox" name="free_shipping"> <span>Бесплатная доставка</span></label>
                            <label class="filter-check"><input type="checkbox" name="fast_shipping"> <span>Быстрая доставка</span></label>
                            <label class="filter-check"><input type="checkbox" name="pickup"> <span>Самовывоз</span></label>
                        </div>
                    </details>

                    <div class="filters-panel__actions">
                        <button class="btn btn-primary btn-sm" type="button" data-wb-demo="Фильтры применены">Применить</button>
                        <button class="btn btn-outline-primary btn-sm" type="button" data-wb-demo="Фильтры сброшены">Сбросить</button>
                    </div>
                </aside>

                <main class="catalog-main">
                    <div class="catalog-toolbar">
                        <div class="catalog-toolbar__count">Найдено <strong>{{ products|length }}</strong> {{ products|length == 1 ? 'товар' : (products|length < 5 ? 'товара' : 'товаров') }}</div>
                        <div class="catalog-toolbar__tools">
                            <label class="sort-control">Сортировка
                                <select aria-label="Сортировка">
                                    <option>По популярности</option>
                                    <option>По рейтингу</option>
                                    <option>По цене ↑</option>
                                    <option>По цене ↓</option>
                                    <option>Новинки</option>
                                </select>
                            </label>
                        </div>
                    </div>

                    <div class="catalog-grid">
                        {% for product in products %}
                            {{ include('components/product_card.html.twig') }}
                        {% else %}
                            <div class="wb-empty" style="grid-column: 1 / -1;">
                                <span class="wb-empty__icon"><i class="bi bi-search"></i></span>
                                <h2>Товары не найдены</h2>
                                <p>Попробуйте изменить категорию или фильтры.</p>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="pagination-wrap">
                        <nav aria-label="Страницы каталога">
                            <ul class="pagination">
                                <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-left"></i></span></li>
                                <li class="page-item active"><span class="page-link">1</span></li>
                                <li class="page-item"><a class="page-link" href="#" data-wb-demo="Страница 2">2</a></li>
                                <li class="page-item"><a class="page-link" href="#" data-wb-demo="Страница 3">3</a></li>
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                                <li class="page-item"><a class="page-link" href="#" data-wb-demo="Страница 12">12</a></li>
                                <li class="page-item"><a class="page-link" href="#" data-wb-demo="Страница 2"><i class="bi bi-chevron-right"></i></a></li>
                            </ul>
                        </nav>
                    </div>
                </main>
            </div>
        </div>
    </div>
{% endblock %}
