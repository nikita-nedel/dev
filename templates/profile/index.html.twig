{% extends 'base.html.twig' %}

{% block title %}Личный кабинет — WB Style{% endblock %}

{% block body %}
    <div class="wb-page-head">
        <div class="container">
            <nav class="wb-breadcrumbs" aria-label="Хлебные крошки">
                <a href="{{ path('app_home') }}">Главная</a>
                <span class="sep">/</span>
                <span aria-current="page">Личный кабинет</span>
            </nav>
            <div class="wb-page-title-row">
                <div>
                    <h1>Личный кабинет</h1>
                    <p>Заказы, избранное, бонусы и настройки — всё в одном месте.</p>
                </div>
                <button class="btn btn-outline-primary" type="button" data-wb-demo="Редактирование профиля">
                    <i class="bi bi-pencil-square"></i> Редактировать профиль
                </button>
            </div>
        </div>
    </div>

    <div class="container profile-layout">
        <section class="profile-hero" aria-labelledby="profile-name">
            <div class="profile-identity">
                <span class="profile-avatar" aria-hidden="true">{% set profileName = app.user.fullName|default(app.user.userIdentifier) %}{{ profileName|split(' ')|first|first|upper }}{{ profileName|split(' ')|length > 1 ? profileName|split(' ')|last|first|upper : '' }}</span>
                <div>
                    <div style="display:flex; align-items:center; flex-wrap:wrap; gap:8px;">
                        <h1 id="profile-name">{{ app.user.fullName|default(app.user.firstName|default('Покупатель')) }}</h1>
                        <span class="profile-level"><i class="bi bi-gem"></i> Gold</span>
                    </div>
                    <div class="profile-meta">
                        <span><i class="bi bi-envelope"></i>{{ app.user.email }}</span>
                        <span><i class="bi bi-telephone"></i>{{ app.user.phone|default('+7 900 000-00-00') }}</span>
                        {% set monthNames = {'01': 'января', '02': 'февраля', '03': 'марта', '04': 'апреля', '05': 'мая', '06': 'июня', '07': 'июля', '08': 'августа', '09': 'сентября', '10': 'октября', '11': 'ноября', '12': 'декабря'} %}
                        {% set createdMonth = app.user.createdAt ? app.user.createdAt|date('m') : '01' %}
                        <span><i class="bi bi-calendar-heart"></i>С нами с {{ monthNames[createdMonth] }} {{ app.user.createdAt ? app.user.createdAt|date('Y') : '2024' }}</span>
                    </div>
                </div>
            </div>
            <div class="profile-hero__side">
                <div class="profile-bonus">
                    <div class="profile-bonus__label">Бонусный баланс</div>
                    <div class="profile-bonus__value">4 820 <span>бонусов</span></div>
                    <div class="profile-bonus__bar"><span></span></div>
                    <p class="profile-bonus__note">До Platinum — 1 180 бонусов</p>
                </div>
                <button class="btn btn-outline-light" type="button" data-wb-demo="Списание бонусов">Потратить</button>
            </div>
        </section>

        <div class="profile-grid">
            <aside class="profile-side" aria-label="Разделы профиля">
                <div class="profile-nav-card">
                    <nav class="profile-nav">
                        <a class="is-active" href="{{ path('app_profile') }}"><i class="bi bi-person"></i>Профиль</a>
                        <a href="{{ path('app_orders') }}"><i class="bi bi-box-seam"></i>Мои заказы<span class="profile-nav__count profile-nav__count--alert">1</span></a>
                        <a class="is-soon" href="#" data-wb-demo="Избранное" aria-disabled="true" tabindex="-1"><i class="bi bi-heart"></i>Избранное<span class="profile-nav__count">34</span><span class="profile-nav__soon">Скоро</span></a>
                        <a href="#profile-address"><i class="bi bi-geo-alt"></i>Адреса доставки</a>
                        <button class="is-soon" type="button" data-wb-demo="Платежи" aria-disabled="true" tabindex="-1"><i class="bi bi-credit-card"></i>Платежи<span class="profile-nav__soon">Скоро</span></button>
                        <button class="is-soon" type="button" data-wb-demo="Уведомления" aria-disabled="true" tabindex="-1"><i class="bi bi-bell"></i>Уведомления<span class="profile-nav__count profile-nav__count--alert">2</span><span class="profile-nav__soon">Скоро</span></button>
                        <button class="is-soon" type="button" data-wb-demo="Безопасность" aria-disabled="true" tabindex="-1"><i class="bi bi-lock"></i>Безопасность<span class="profile-nav__soon">Скоро</span></button>
                        <div class="profile-nav__sep"></div>
                        <a class="is-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right"></i>Выйти</a>
                    </nav>
                </div>
                <a class="profile-side__help is-soon" href="#" data-wb-demo="Чат поддержки" aria-disabled="true" tabindex="-1">
                    <i class="bi bi-question-circle"></i>
                    <span><strong>Нужна помощь?</strong><span>Поддержка 24/7</span></span>
                    <span class="profile-nav__soon">Скоро</span>
                </a>
            </aside>

            <div class="profile-main">
                <div class="profile-stats" role="group" aria-label="Статистика профиля">
                    {% for stat in profileStats %}
                        <div class="profile-stat">
                            <span class="profile-stat__icon"><i class="bi {{ stat.icon }}"></i></span>
                            <div><div class="profile-stat__value">{{ stat.value }}</div><div class="profile-stat__label">{{ stat.label|lower }}</div></div>
                        </div>
                    {% endfor %}
                </div>

                <div class="profile-content">
                    <div class="profile-column">
                        <section class="profile-panel" id="profile-orders" aria-labelledby="profile-orders-title">
                            <div class="profile-panel__head">
                                <h2 id="profile-orders-title">Последние заказы</h2>
                                <a class="wb-link" href="{{ path('app_orders') }}">Все заказы <i class="bi bi-arrow-right"></i></a>
                            </div>
                            <div class="profile-tabs" role="group" aria-label="Фильтр заказов">
                                <button class="profile-tab is-active" type="button" data-order-filter="all" aria-pressed="true">Все</button>
                                <button class="profile-tab" type="button" data-order-filter="transit" aria-pressed="false">В пути</button>
                                <button class="profile-tab" type="button" data-order-filter="done" aria-pressed="false">Получены</button>
                            </div>
                            <div class="order-list">
                                {% for order in recentOrders %}
                                    <article class="order-card" data-order-status="{{ order.status == 'В пути' ? 'transit' : 'done' }}">
                                        <div class="order-card__head">
                                            <span class="order-card__number">{{ order.number }}</span>
                                            <span class="order-card__date">{{ order.date }}</span>
                                            <span class="order-card__status {{ order.status == 'В пути' ? 'order-status--transit' : 'order-status--done' }}">{{ order.status }}</span>
                                        </div>
                                        <div class="order-card__body">
                                            <div class="order-thumbs" aria-hidden="true">
                                                {% if order.images is defined and order.images %}
                                                    {% for image in order.images|slice(0, 2) %}
                                                        <span class="order-thumb"><img src="{{ image }}" alt=""></span>
                                                    {% endfor %}
                                                {% else %}
                                                    <span class="order-thumb"><i class="bi bi-box-seam" style="display:grid; place-items:center; height:100%; color:var(--wb-muted);"></i></span>
                                                {% endif %}
                                            </div>
                                            <div class="order-card__info">
                                                <p class="order-card__title">{{ order.title }}</p>
                                                <p class="order-card__meta">{{ order.meta|default('') }}</p>
                                                <div class="order-progress"><span style="width: {{ order.progress }}%"></span></div>
                                                <div class="order-steps"><span>Собран</span><span class="{{ order.progress < 100 ? 'is-current' : '' }}">В пути</span><span class="{{ order.progress == 100 ? 'is-current' : '' }}">Доставлен</span></div>
                                            </div>
                                        </div>
                                        <div class="order-card__foot">
                                            <span class="order-card__total">{{ order.total|number_format(0, ',', ' ') }} ₽ {% set orderCount = order.itemCount|default(1) %}<span>{{ orderCount }} {{ orderCount == 1 ? 'товар' : (orderCount < 5 ? 'товара' : 'товаров') }}</span></span>
                                            <div class="order-card__actions">
                                                <button type="button" data-wb-demo="Детали заказа">Детали</button>
                                                <button type="button" data-wb-demo="Повторить заказ">Повторить</button>
                                            </div>
                                        </div>
                                    </article>
                                {% endfor %}
                            </div>
                        </section>

                        <section class="profile-panel" aria-labelledby="quick-actions-title">
                            <div class="profile-panel__head"><h2 id="quick-actions-title">Быстрые действия</h2></div>
                            <div class="quick-grid">
                                {% for action in quickActions %}
                                    <a class="quick-action" href="{{ action.url }}">
                                        <span class="quick-action__icon"><i class="bi {{ action.icon }}"></i></span>
                                        <span><strong>{{ action.title }}</strong><span>{{ action.description }}</span></span>
                                    </a>
                                {% endfor %}
                            </div>
                        </section>
                    </div>

                    <aside class="profile-column">
                        <section class="loyalty-card" aria-labelledby="loyalty-title">
                            <div class="loyalty-card__top">
                                <span class="loyalty-card__label">WB Club</span>
                                <span class="loyalty-card__level"><i class="bi bi-gem"></i> Gold</span>
                            </div>
                            <h2 class="loyalty-card__points" id="loyalty-title">4 820 <span>бонусов</span></h2>
                            <div class="loyalty-card__bar"><span></span></div>
                            <p class="loyalty-card__note">До Platinum осталось 1 180. Бонусами можно оплатить до 30% заказа.</p>
                            <button class="btn btn-light" type="button" data-wb-demo="Списание бонусов">Потратить бонусы</button>
                        </section>

                        <section class="profile-address" id="profile-address" aria-labelledby="profile-address-title">
                            <span class="profile-address__icon"><i class="bi bi-geo-alt"></i></span>
                            <div style="flex:1; min-width:0;">
                                <div class="profile-address__head">
                                    <strong id="profile-address-title">Основной адрес</strong>
                                    <button type="button" data-wb-demo="Изменение адреса">Изменить</button>
                                </div>
                                <p>Санкт-Петербург, ул. Лесная, 7, кв. 12</p>
                                <span class="profile-address__tag">ПВЗ WB Style · ул. Лесная, 7</span>
                            </div>
                        </section>

                        {% set sellerAccount = customer_seller(app.user) %}
                        {% if sellerAccount is null %}
                            <section class="profile-seller-card">
                                <i class="bi bi-shop"></i>
                                <h2>Продавайте на WB Style</h2>
                                <p>Откройте магазин за 10 минут и получайте выплаты каждую неделю.</p>
                                <a class="btn btn-primary" href="{{ path('seller_apply') }}">Стать продавцом <i class="bi bi-arrow-right"></i></a>
                            </section>
                        {% elseif sellerAccount.isActive %}
                            <section class="profile-seller-card">
                                <i class="bi bi-shop"></i>
                                <h2>Ваш магазин</h2>
                                <p>Управляйте товарами, заказами и витриной в кабинете продавца.</p>
                                <a class="btn btn-primary" href="{{ path('app_seller_dashboard') }}">В кабинет <i class="bi bi-arrow-right"></i></a>
                            </section>
                        {% else %}
                            <section class="profile-seller-card">
                                <i class="bi bi-hourglass-split"></i>
                                <h2>Заявка на проверке</h2>
                                <p>Мы проверяем данные магазина. Обычно это занимает до одного рабочего дня.</p>
                                <a class="btn btn-primary" href="{{ path('seller_apply') }}">Статус заявки</a>
                            </section>
                        {% endif %}

                        <section class="profile-panel" aria-labelledby="activity-title">
                            <div class="profile-panel__head"><h2 id="activity-title">Активность</h2></div>
                            <div class="activity-list">
                                {% for item in activity %}
                                    <div class="activity-item">
                                        <span class="activity-item__icon"><i class="bi {{ item.icon }}"></i></span>
                                        <div><p>{{ item.text }}</p><span>{{ item.time }}</span></div>
                                    </div>
                                {% endfor %}
                            </div>
                        </section>
                    </aside>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
