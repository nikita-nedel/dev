<div class="wb-topbar">
    <div class="container wb-topbar__inner">
        <div class="wb-topbar__group">
            <span><i class="bi bi-truck"></i> Доставка от 1 дня · 8 400 пунктов выдачи</span>
        </div>
        <div class="wb-topbar__group wb-topbar__group--links">
            <a class="wb-topbar__sale" href="{{ path('cat', {slug: 'odezhda'}) }}">Распродажа до −50%</a>
            <a href="{{ path('seller_apply') }}">Продавцам</a>
            <a href="tel:+78005553535">8 800 555-35-35</a>
        </div>
    </div>
</div>

<header class="wb-header">
    <div class="container wb-header__main">
        <button class="wb-menu-btn" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="wb-mobile-nav" data-wb-menu>
            <i class="bi bi-list"></i>
        </button>

        <a class="wb-brand" href="{{ path('app_home') }}" aria-label="WB Style — на главную">
            <span class="wb-brand__mark">W</span>
            <span class="wb-brand__name">WB <span>Style</span></span>
        </a>

        <form class="wb-search" role="search" action="{{ path('cat') }}" method="get">
            <input type="search" name="q" value="{{ app.request.query.get('q') }}" placeholder="Найти вещь, бренд или продавца" aria-label="Поиск по магазину">
            <button type="submit" aria-label="Найти"><i class="bi bi-search"></i></button>
        </form>

        <div class="wb-actions">
            <a class="wb-action" href="#" data-wb-favorites>
                <i class="bi bi-heart"></i>
                <span>Избранное</span>
            </a>
            <a class="wb-action" href="{{ path('cart') }}">
                <i class="bi bi-bag"></i>
                <span>Корзина</span>
            </a>

            {% if app.user %}
                <div class="dropdown">
                    <button class="wb-account dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person"></i>
                        <span>{{ app.user.firstName|default(app.user.userIdentifier) }}</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end">
                        <a class="dropdown-item" href="{{ path('app_profile') }}"><i class="bi bi-person me-2"></i>Профиль</a>
                        <a class="dropdown-item" href="{{ path('app_orders') }}"><i class="bi bi-box-seam me-2"></i>Заказы</a>
                        <a class="dropdown-item" href="#" data-wb-favorites><i class="bi bi-heart me-2"></i>Избранное</a>
                        <div class="dropdown-divider"></div>
                        {% set sellerAccount = customer_seller(app.user) %}
                        {% if sellerAccount is null %}
                            <a class="dropdown-item" href="{{ path('seller_apply') }}"><i class="bi bi-shop me-2"></i>Стать продавцом</a>
                        {% elseif sellerAccount.isActive %}
                            <a class="dropdown-item" href="{{ path('app_seller_dashboard') }}"><i class="bi bi-shop me-2"></i>Магазин продавца</a>
                        {% else %}
                            <a class="dropdown-item" href="{{ path('seller_apply') }}"><i class="bi bi-hourglass me-2"></i>Статус заявки</a>
                        {% endif %}
                        <a class="dropdown-item" href="{{ path('app_admin_dashboard') }}"><i class="bi bi-shield-lock me-2"></i>Админ-панель</a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item text-brick" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Выйти</a>
                    </div>
                </div>
            {% else %}
                <a class="wb-account" href="{{ path('app_login') }}">
                    <i class="bi bi-person"></i>
                    <span>Войти</span>
                </a>
            {% endif %}
        </div>
    </div>

    <div class="wb-nav">
        <div class="container wb-nav__inner">
            <a class="wb-catalog-btn" href="{{ path('cat') }}">
                <i class="bi bi-grid-3x3-gap"></i> Каталог
            </a>
            <nav class="wb-nav__links" aria-label="Категории">
                <a href="{{ path('cat', {slug: 'odezhda'}) }}">Одежда</a>
                <a href="{{ path('cat', {slug: 'obuv'}) }}">Обувь</a>
                <a href="{{ path('cat', {slug: 'aksessuary'}) }}">Аксессуары</a>
                <a href="{{ path('cat', {slug: 'elektronika'}) }}">Электроника</a>
                <a href="{{ path('cat', {slug: 'krasota'}) }}">Красота</a>
                <a href="{{ path('cat', {slug: 'dom-i-sad'}) }}">Дом</a>
            </nav>
            <a class="wb-nav__sale" href="{{ path('cat', {slug: 'odezhda'}) }}">Распродажа</a>
        </div>
    </div>

    <nav class="wb-mobile-nav" id="wb-mobile-nav" aria-label="Мобильная навигация">
        <a href="{{ path('app_home') }}">Главная</a>
        <a href="{{ path('cat', {slug: 'odezhda'}) }}">Одежда</a>
        <a href="{{ path('cat', {slug: 'obuv'}) }}">Обувь</a>
        <a href="{{ path('cat', {slug: 'elektronika'}) }}">Электроника</a>
        <a href="{{ path('cart') }}">Корзина</a>
        {% if app.user %}
            <a href="{{ path('app_profile') }}">Профиль</a>
            <a href="{{ path('app_orders') }}">Заказы</a>
        {% else %}
            <a href="{{ path('app_login') }}">Войти</a>
            <a href="{{ path('app_register') }}">Регистрация</a>
        {% endif %}
    </nav>
</header>
