<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Админ-панель{% endblock %} — WB Style</title>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}    {# Bootstrap + иконки + общие стили #}
        {{ encore_entry_link_tags('admin') }}  {# только админка #}
    {% endblock %}
</head>
<body class="admin-body">
<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="admin-sidebar-brand">
            <a href="{{ path('app_admin_dashboard') }}">
                <span class="brand-icon"><i class="bi bi-grid-1x2-fill"></i></span>
                <span>WB <span class="accent">Admin</span></span>
            </a>
        </div>

        <nav class="admin-nav">
            <div class="admin-nav-section">Пользователи</div>
            <a href="{{ path('app_admin_client_index') }}" class="admin-nav-link {{ admin_menu|default('') == 'clients' ? 'active' : '' }}">
                <i class="bi bi-people"></i>
                <span class="admin-nav-link-label">Клиенты</span>
            </a>
            <a href="{{ path('admin_invite_create') }}" class="admin-nav-link {{ admin_menu|default('') == 'admins' ? 'active' : '' }}">
                <i class="bi bi-shield-lock"></i>
                <span class="admin-nav-link-label">Администраторы</span>
            </a>
            <a href="{{ path('app_admin_seller_request_index') }}" class="admin-nav-link {{ admin_menu|default('') == 'seller_requests' ? 'active' : '' }}">
                <i class="bi bi-shop"></i>
                <span class="admin-nav-link-label">Заявки продавцов</span>
            </a>
            <div class="admin-nav-section">Каталог</div>
            <span class="admin-nav-link is-disabled" title="Скоро">
                <i class="bi bi-folder2-open"></i>
                <span class="admin-nav-link-label">Категории</span>
                <span class="export-format-badge">Скоро</span>
            </span>
            <span class="admin-nav-link is-disabled" title="Скоро">
                <i class="bi bi-box-seam"></i>
                <span class="admin-nav-link-label">Товары</span>
                <span class="export-format-badge">Скоро</span>
            </span>
            <span class="admin-nav-link is-disabled" title="Скоро">
                <i class="bi bi-award"></i>
                <span class="admin-nav-link-label">Зарегистрированные бренды</span>
                <span class="export-format-badge">Скоро</span>
            </span>
            <div class="admin-nav-section">Продажи</div>
            <span class="admin-nav-link is-disabled" title="Скоро">
                <i class="bi bi-receipt"></i>
                <span class="admin-nav-link-label">Заказы и корзины</span>
                <span class="export-format-badge">Скоро</span>
            </span>
            <div class="admin-nav-section">Процессы</div>
            <a href="{{ path('app_admin_process_index') }}" class="admin-nav-link {{ admin_menu|default('') == 'processes' ? 'active' : '' }}">
                <i class="bi bi-list-task"></i>
                <span class="admin-nav-link-label">Фоновые процессы</span>
            </a>
            <div class="admin-nav-section">Доступ</div>
            <span class="admin-nav-link is-disabled" title="Скоро">
                <i class="bi bi-key"></i>
                <span class="admin-nav-link-label">Роли</span>
                <span class="export-format-badge">Скоро</span>
            </span>
            <span class="admin-nav-link is-disabled" title="Скоро">
                <i class="bi bi-diagram-3"></i>
                <span class="admin-nav-link-label">Группы ролей</span>
                <span class="export-format-badge">Скоро</span>
            </span>
        </nav>
        <div class="admin-sidebar-footer">
            <a href="{{ path('app_home') }}">
                <i class="bi bi-arrow-left-circle"></i> На сайт
            </a>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <h1>{% block page_title %}Панель управления{% endblock %}</h1>
            <div class="admin-topbar-actions">
                {% if app.user %}
                    <div class="admin-user-badge">
                        <span class="avatar">{{ app.user.userIdentifier|first|upper }}</span>
                        <span>{{ app.user.fullName|default(app.user.userIdentifier) }}</span>
                    </div>
                    <a href="{{ path('admin_logout') }}" class="btn-admin-outline btn-sm ms-2">Выйти</a>
                {% endif %}
            </div>
        </header>

        <div class="admin-content">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    {{ message|raw }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {% block admin_body %}{% endblock %}
        </div>
    </div>
</div>

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}   {# bootstrap, showToast #}
    {# admin.js можно не подключать, если в admin.js только import scss #}
{% endblock %}
</body>
</html>