{% extends 'admin/security/layout.html.twig' %}

{% block title %}Вход администратора{% endblock %}

{% block auth_body %}
    <div class="admin-auth-page">
        <div class="admin-auth-card">
            <div class="admin-auth-card-header">
                <a href="{{ path('app_home') }}" class="admin-auth-brand">
                    <span class="admin-auth-brand-icon"><i class="bi bi-grid-1x2-fill"></i></span>
                    <span>WB <span class="accent">Admin</span></span>
                </a>
                <h1>Вход в панель</h1>
                <p>Используйте учётную запись администратора</p>
            </div>

            <div class="admin-auth-card-body">
                {% if error %}
                    <div class="admin-auth-alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" action="{{ path('admin_login') }}">
                    <div class="admin-auth-field">
                        <label for="username">Email</label>
                        <input
                            type="email"
                            id="username"
                            name="_username"
                            class="admin-input"
                            value="{{ last_username }}"
                            placeholder="admin@example.com"
                            autocomplete="username"
                            required
                            autofocus
                        >
                    </div>

                    <div class="admin-auth-field">
                        <label for="password">Пароль</label>
                        <input
                            type="password"
                            id="password"
                            name="_password"
                            class="admin-input"
                            placeholder="Введите пароль"
                            autocomplete="current-password"
                            required
                        >
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn-admin-primary admin-auth-submit">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Войти
                    </button>
                </form>

                <div class="admin-auth-footer">
                    <a href="{{ path('app_home') }}">
                        <i class="bi bi-arrow-left"></i> Вернуться на сайт
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
