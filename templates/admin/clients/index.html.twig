{% extends 'admin/layout.html.twig' %}

{% block title %}Клиенты{% endblock %}
{% block page_title %}Клиенты{% endblock %}

{% block admin_body %}
    <div class="clients-stats stats-grid">
        <div class="stat-card">
            <div class="stat-card-header">
                <div>
                    <div class="stat-card-label">Всего клиентов</div>
                    <div class="stat-card-value" id="clients-count-total">{{ stats.total }}</div>
                </div>
                <div class="stat-card-icon visitors"><i class="bi bi-people"></i></div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-header">
                <div>
                    <div class="stat-card-label">Активные</div>
                    <div class="stat-card-value">{{ stats.active }}</div>
                </div>
                <div class="stat-card-icon revenue"><i class="bi bi-person-check"></i></div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-header">
                <div>
                    <div class="stat-card-label">Новые</div>
                    <div class="stat-card-value">{{ stats.new }}</div>
                </div>
                <div class="stat-card-icon orders"><i class="bi bi-person-plus"></i></div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-header">
                <div>
                    <div class="stat-card-label">Заблокированные</div>
                    <div class="stat-card-value">{{ stats.blocked }}</div>
                </div>
                <div class="stat-card-icon carts"><i class="bi bi-person-x"></i></div>
            </div>
        </div>
    </div>

    <div class="admin-panel clients-panel">
        <div class="admin-panel-header clients-toolbar">
            <h2><i class="bi bi-funnel me-2 text-secondary"></i>Фильтры и сортировка</h2>
            <button type="button" class="btn-admin-outline btn-sm" id="clients-reset-filters">
                <i class="bi bi-arrow-counterclockwise"></i> Сбросить
            </button>
        </div>

        <div class="clients-filters">
            <div class="clients-filter-search">
                <i class="bi bi-search"></i>
                <input type="search" id="clients-search" class="admin-input" placeholder="Поиск по имени, email или телефону…" autocomplete="off">
            </div>
            <select id="clients-filter-status" class="admin-select" aria-label="Статус">
                <option value="">Все статусы</option>
                <option value="active">Активен</option>
                <option value="new">Новый</option>
                <option value="inactive">Неактивен</option>
                <option value="blocked">Заблокирован</option>
            </select>
            <select id="clients-filter-period" class="admin-select" aria-label="Период регистрации">
                <option value="">Любая дата</option>
                <option value="7">За 7 дней</option>
                <option value="30">За 30 дней</option>
                <option value="90">За 3 месяца</option>
                <option value="365">За год</option>
            </select>
            <select id="clients-sort" class="admin-select" aria-label="Сортировка">
                <option value="name-asc">Имя А→Я</option>
                <option value="name-desc">Имя Я→А</option>
                <option value="date-desc">Дата регистрации (новые)</option>
                <option value="date-asc">Дата регистрации (старые)</option>
                <option value="orders-desc">Больше заказов</option>
                <option value="spent-desc">Больше потрачено</option>
            </select>
        </div>

        <div class="clients-results-bar">
            <span>Найдено: <strong id="clients-count-visible">{{ clients|length }}</strong></span>
            <button type="button" class="btn-admin-primary btn-sm">
                <i class="bi bi-download"></i> Экспорт
            </button>
        </div>

        <div class="table-responsive">
            <table class="orders-table clients-table" id="clients-table">
                <thead>
                <tr>
                    <th>Клиент</th>
                    <th>Контакты</th>
                    <th>Регистрация</th>
                    <th>Заказы</th>
                    <th>Потрачено</th>
                    <th>Статус</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for client in clients %}
                    <tr class="client-row"
                        data-id="{{ client.id }}"
                        data-name="{{ client.name|lower }}"
                        data-email="{{ client.email|lower }}"
                        data-phone="{{ client.phone }}"
                        data-status="{{ client.status }}"
                        data-registered="{{ client.registeredAt|date('U') }}"
                        data-orders="{{ client.ordersCount }}"
                        data-spent="{{ client.totalSpent }}">
                        <td>
                            <div class="client-cell-main">
                                <span class="client-avatar">{{ client.name|split(' ')|first|first }}{{ client.name|split(' ')|last|default('')|first }}</span>
                                <div>
                                    <div class="client-name">{{ client.name }}</div>
                                    <div class="client-id">ID {{ client.id }}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="client-contact">
                                <a href="mailto:{{ client.email }}">{{ client.email }}</a>
                                <span>{{ client.phone }}</span>
                            </div>
                        </td>
                        <td>{{ client.registeredAt|date('d.m.Y') }}</td>
                        <td><strong>{{ client.ordersCount }}</strong></td>
                        <td><strong>{{ client.totalSpent|number_format(0, ',', ' ') }} ₽</strong></td>
                        <td>
                            <span class="badge-client {{ client.status }}">{{ client.statusLabel }}</span>
                        </td>
                        <td>
                            <div class="client-actions">
                                <button type="button" class="btn-icon" title="Профиль"><i class="bi bi-eye"></i></button>
                                <button type="button" class="btn-icon" title="Заказы"><i class="bi bi-bag"></i></button>
                                <button type="button" class="btn-icon" title="Написать"><i class="bi bi-envelope"></i></button>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="clients-empty hidden" id="clients-empty">
            <i class="bi bi-search"></i>
            <p>Клиенты не найдены</p>
            <span>Попробуйте изменить фильтры или поисковый запрос</span>
        </div>

        <div class="clients-pagination">
            <span class="text-muted">Показано <span id="clients-range">1–{{ clients|length }}</span> из <span id="clients-total">{{ clients|length }}</span></span>
            <div class="pagination-btns">
                <button type="button" class="btn-admin-outline btn-sm" disabled><i class="bi bi-chevron-left"></i></button>
                <button type="button" class="btn-admin-outline btn-sm active">1</button>
                <button type="button" class="btn-admin-outline btn-sm" disabled><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
    </div>
{% endblock %}