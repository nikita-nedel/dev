<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#27373e">
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <title>{% block title %}Кабинет продавца{% endblock %} — WB Style</title>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        {{ encore_entry_link_tags('admin') }}
    {% endblock %}
</head>
<body class="admin-body">
<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="admin-sidebar-brand">
            <a href="{{ path('app_seller_dashboard') }}">
                <span class="brand-icon">W</span>
                <span>WB <span class="accent">Seller</span></span>
            </a>
        </div>
        <nav class="admin-nav">
            <div class="admin-nav-section">Магазин</div>
            <a href="{{ path('app_seller_dashboard') }}" class="admin-nav-link {{ app.request.attributes.get('_route') == 'app_seller_dashboard' ? 'active' : '' }}">
                <i class="bi bi-speedometer2"></i><span class="admin-nav-link-label">Обзор</span>
            </a>
            <a href="{{ path('app_seller_products') }}" class="admin-nav-link {{ app.request.attributes.get('_route') starts with 'app_seller_products' ? 'active' : '' }}">
                <i class="bi bi-box-seam"></i><span class="admin-nav-link-label">Товары</span>
            </a>
            <a href="{{ path('app_seller_products_new') }}" class="admin-nav-link">
                <i class="bi bi-plus-square"></i><span class="admin-nav-link-label">Новый товар</span>
            </a>
            <a href="{{ path('app_seller_category_index') }}" class="admin-nav-link {{ app.request.attributes.get('_route') starts with 'app_seller_category' ? 'active' : '' }}">
                <i class="bi bi-tags"></i><span class="admin-nav-link-label">Категории</span>
            </a>
            <div class="admin-nav-section">Аккаунт</div>
            <a href="{{ path('app_seller_profile') }}" class="admin-nav-link {{ app.request.attributes.get('_route') starts with 'app_seller_profile' ? 'active' : '' }}">
                <i class="bi bi-person-gear"></i><span class="admin-nav-link-label">Профиль продавца</span>
            </a>
            <a href="{{ path('app_home') }}" class="admin-nav-link">
                <i class="bi bi-arrow-left-circle"></i><span class="admin-nav-link-label">На сайт</span>
            </a>
            <a href="{{ path('seller_logout') }}" class="admin-nav-link">
                <i class="bi bi-box-arrow-right"></i><span class="admin-nav-link-label">Выйти</span>
            </a>
        </nav>
        <div class="admin-sidebar-footer">
            <span class="admin-sidebar-note">WB Style · Seller</span>
        </div>
    </aside>
    <div class="admin-main">
        <header class="admin-topbar">
            <div>
                <span class="admin-topbar-kicker">Кабинет продавца</span>
                <h1>{% block page_title %}Обзор{% endblock %}</h1>
            </div>
            {% if app.user %}
                {% set sellerCustomerProfile = app.user.customer is not null ? app.user.customer.profile : null %}
                {% set sellerDisplayName = sellerCustomerProfile is not null ? sellerCustomerProfile.fullName : app.user.email %}
                <div class="admin-topbar-actions">
                    <a href="{{ path('app_seller_profile') }}" class="admin-user-badge" title="Профиль продавца">
                        <span class="avatar">{{ sellerDisplayName|first|upper }}</span>
                        <span>{{ sellerDisplayName }}</span>
                    </a>
                </div>
            {% endif %}
        </header>
        <div class="admin-content">
            {% set flashes = app.flashes %}
            {% if flashes|length %}
                <div class="admin-flash-stack">
                    {% for type, messages in flashes %}
                        {% for message in messages %}
                            <div class="wb-flash wb-flash--{{ type == 'error' ? 'error' : (type == 'success' ? 'success' : 'info') }}" role="status">
                                <i class="bi {{ type == 'error' ? 'bi-exclamation-circle' : (type == 'success' ? 'bi-check-circle' : 'bi-info-circle') }}"></i>
                                <span>{{ message }}</span>
                                <button class="wb-flash__close" type="button" aria-label="Закрыть" data-wb-flash-close>&times;</button>
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>
            {% endif %}
            {% block seller_body %}{% endblock %}
        </div>
    </div>
</div>
{% block javascripts %}{{ encore_entry_script_tags('app') }}{{ encore_entry_script_tags('admin') }}{% endblock %}
</body>
</html>
