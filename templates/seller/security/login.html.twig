{% extends 'base.html.twig' %}

{% block title %}Вход для продавца — WB Style{% endblock %}

{% block body %}
    <main class="simple-page">
        <div class="container">
            <div class="simple-card">
                <span class="wb-eyebrow">WB Style · продавцам</span>
                <h1 style="margin-top: 10px;">Кабинет продавца</h1>
                <p>Войдите, чтобы управлять товарами и витриной магазина.</p>

                {% if error %}
                    <div class="auth-alert" role="alert" style="margin-top: 16px;">
                        <i class="bi bi-exclamation-circle me-1"></i>{{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" action="{{ path('seller_login') }}" style="margin-top: 18px;">
                    <div class="form-group">
                        <label class="form-label" for="username">E-mail</label>
                        <input class="form-control" type="email" id="username" name="_username" value="{{ last_username }}" placeholder="seller@example.com" autocomplete="username" required autofocus>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="password">Пароль</label>
                        <div class="auth-input-wrap">
                            <input class="form-control" type="password" id="password" name="_password" placeholder="Введите пароль" autocomplete="current-password" required>
                            <button class="auth-eye" type="button" aria-label="Показать пароль" data-toggle-password="#password"><i class="bi bi-eye"></i></button>
                        </div>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button class="btn btn-primary w-100" type="submit" style="margin-top: 6px;">Войти <i class="bi bi-arrow-right"></i></button>
                </form>

                <div class="form-actions" style="margin-top: 16px;">
                    <a class="btn btn-outline-primary btn-sm" href="{{ path('seller_apply') }}">Подать заявку</a>
                    <a class="wb-link" href="{{ path('app_home') }}">Вернуться на сайт <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
