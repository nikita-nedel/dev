{% extends 'base.html.twig' %}

{% block title %}Активация аккаунта продавца — WB Style{% endblock %}

{% block body %}
    <main class="simple-page">
        <div class="container">
            <div class="simple-card">
                <span class="wb-eyebrow">WB Style · продавцам</span>
                <h1 style="margin-top: 10px;">Активация кабинета</h1>
                <p>E-mail: <strong>{{ sellerEmail }}</strong>. Придумайте пароль для входа в кабинет.</p>

                {{ form_start(form, {attr: {style: 'margin-top: 18px;'}}) }}
                    {{ form_row(form.plainPassword) }}
                    <button class="btn btn-primary w-100" type="submit" style="margin-top: 8px;">Установить пароль и войти</button>
                {{ form_end(form) }}
            </div>
        </div>
    </main>
{% endblock %}
