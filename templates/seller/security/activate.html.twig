{% extends 'base.html.twig' %}

{% block title %}Активация аккаунта продавца{% endblock %}

{% block body %}
    <div class="container py-5" style="max-width: 480px;">
        <h1 class="h3 mb-2">Активация продавца</h1>
        <p class="text-secondary mb-4">Email: <strong>{{ sellerEmail }}</strong></p>

        {{ form_start(form, { attr: { class: 'card p-4 shadow-sm' } }) }}
            {{ form_row(form.plainPassword) }}
            <button type="submit" class="btn btn-primary w-100 mt-2">Установить пароль и войти</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
