{% extends 'base.html.twig' %}

{% block title %}Статус заявки продавца{% endblock %}

{% block body %}
    <div class="container py-5" style="max-width: 640px;">
        <h1 class="h3 mb-4">Статус заявки</h1>

        <div class="card p-4 shadow-sm">
            <p><strong>Магазин:</strong> {{ sellerRequest.shopName }}</p>
            <p><strong>Статус:</strong> {{ sellerRequest.status.label }}</p>
            <p><strong>Дата подачи:</strong> {{ sellerRequest.createdAt|date('d.m.Y H:i') }}</p>

            {% if sellerRequest.status.value == 'approved' and not seller.isActive %}
                <div class="alert alert-info mt-3">
                    Заявка одобрена. Установите пароль продавца по ссылке из уведомления или обратитесь к администратору.
                </div>
                <a href="{{ path('seller_login') }}" class="btn btn-primary">Перейти ко входу продавца</a>
            {% elseif sellerRequest.status.value == 'approved' and seller.isActive %}
                <a href="{{ path('app_seller_dashboard') }}" class="btn btn-primary mt-3">Открыть кабинет продавца</a>
            {% elseif sellerRequest.status.value == 'rejected' %}
                <div class="alert alert-warning mt-3">
                    {{ sellerRequest.rejectionReason|default('Заявка отклонена администратором.') }}
                </div>
            {% else %}
                <div class="alert alert-secondary mt-3">Заявка ожидает рассмотрения администратором.</div>
            {% endif %}
        </div>
    </div>
{% endblock %}
