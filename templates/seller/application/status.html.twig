{% extends 'base.html.twig' %}

{% block title %}Статус заявки продавца — WB Style{% endblock %}

{% block body %}
    <main class="simple-page">
        <div class="container">
            <div class="simple-card">
                <span class="wb-eyebrow">WB Style · продавцам</span>
                <h1 style="margin-top: 10px;">Статус заявки</h1>

                <div class="status-panel">
                    <i class="bi bi-shop"></i>
                    <div>
                        <strong>{{ sellerRequest.shopName }}</strong>
                        <p>Статус: {{ sellerRequest.status.label }} · подана {{ sellerRequest.createdAt|date('d.m.Y H:i') }}</p>
                    </div>
                </div>

                {% if sellerRequest.status.value == 'approved' and not seller.isActive %}
                    <div class="status-panel" style="margin-top: 12px;">
                        <i class="bi bi-envelope-check"></i>
                        <div>
                            <strong>Заявка одобрена</strong>
                            <p>Установите пароль продавца по ссылке из уведомления или обратитесь к администратору.</p>
                        </div>
                    </div>
                    <div class="form-actions"><a class="btn btn-primary" href="{{ path('seller_login') }}">Перейти ко входу продавца</a></div>
                {% elseif sellerRequest.status.value == 'approved' and seller.isActive %}
                    <div class="form-actions"><a class="btn btn-primary" href="{{ path('app_seller_dashboard') }}">Открыть кабинет продавца <i class="bi bi-arrow-right"></i></a></div>
                {% elseif sellerRequest.status.value == 'rejected' %}
                    <div class="auth-alert" style="margin-top: 12px;">{{ sellerRequest.rejectionReason|default('Заявка отклонена администратором.') }}</div>
                {% else %}
                    <div class="status-panel" style="margin-top: 12px;">
                        <i class="bi bi-hourglass-split"></i>
                        <div><strong>Заявка на рассмотрении</strong><p>Обычно проверка занимает до одного рабочего дня.</p></div>
                    </div>
                {% endif %}
            </div>
        </div>
    </main>
{% endblock %}
