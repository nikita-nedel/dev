{% extends 'base.html.twig' %}

{% block title %}Стать продавцом — WB Style{% endblock %}

{% block body %}
    <main class="simple-page">
        <div class="container">
            <div class="simple-card">
                <span class="wb-eyebrow">WB Style · продавцам</span>
                <h1 style="margin-top: 10px;">Заявка на открытие магазина</h1>
                <p>Заполните данные магазина. После проверки администратором вы получите доступ в кабинет продавца.</p>

                {{ form_start(form, {attr: {style: 'margin-top: 18px;'}}) }}
                    <div class="form-group">{{ form_row(form.shopName) }}</div>
                    <div class="form-group">{{ form_row(form.legalName) }}</div>
                    <div class="auth-row">
                        <div class="form-group">{{ form_row(form.inn) }}</div>
                        <div class="form-group">{{ form_row(form.contactPhone) }}</div>
                    </div>
                    <div class="form-group">{{ form_row(form.description) }}</div>
                    <div class="form-actions">
                        <button class="btn btn-primary" type="submit">Отправить заявку <i class="bi bi-arrow-right"></i></button>
                        <a class="btn btn-outline-primary" href="{{ path('app_home') }}">Отмена</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </main>
{% endblock %}
