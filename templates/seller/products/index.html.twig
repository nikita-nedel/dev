{% extends 'seller/layout.html.twig' %}

{% block title %}Товары{% endblock %}
{% block page_title %}Управление товарами{% endblock %}

{% block seller_body %}
    <div class="admin-panel clients-panel">
        <div class="admin-panel-header">
            <h2>Список товаров</h2>
            <a href="{{ path('app_seller_products_new') }}" class="btn-admin-primary" style="color:#fff;">
                <i class="bi bi-plus-lg"></i> Добавить товар
            </a>
        </div>

        {% if shopNames is empty %}
            <div class="clients-empty">
                <i class="bi bi-shop"></i>
                <p>Сначала нужен магазин</p>
                <span>Магазин создаётся при одобрении заявки продавца.</span>
            </div>
        {% else %}
            <div class="clients-results-bar">
                <span>Найдено товаров: <strong>{{ pagination.totalItemCount }}</strong></span>
            </div>

            <div class="table-responsive">
                <table class="orders-table">
                    <thead>
                    <tr>
                        <th>Название / Артикул</th>
                        <th>Магазин</th>
                        <th>Цена</th>
                        <th>Статус</th>
                        <th style="text-align: right;">Действия</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for product in pagination %}
                        <tr>
                            <td>
                                <div class="client-cell-main">
                                    <div>
                                        <div class="client-name">{{ product.name }}</div>
                                        <div class="client-id">Арт. {{ product.sku }}</div>
                                    </div>
                                </div>
                            </td>
                            <td>{{ shopNames[product.shopId]|default('—') }}</td>
                            <td>{{ product.priceFormatted }}</td>
                            <td>
                                <span class="badge-status {{ product.status.badgeClass }}">{{ product.status.label }}</span>
                            </td>
                            <td style="text-align: right;">
                                <div class="client-actions" style="justify-content: flex-end;">
                                    {% if not product.archived %}
                                        <a href="{{ path('app_seller_products_edit', {id: product.id}) }}"
                                           class="btn-icon" title="Редактировать">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    {% endif %}

                                    {% if product.status.value == 'draft' %}
                                        <form method="post"
                                              action="{{ path('app_seller_products_publish', {id: product.id}) }}"
                                              style="display:inline;">
                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('product_publish_' ~ product.id) }}">
                                            <button class="btn-icon" type="submit" title="Опубликовать">
                                                <i class="bi bi-send"></i>
                                            </button>
                                        </form>
                                    {% endif %}

                                    {% if not product.archived %}
                                        <form method="post"
                                              action="{{ path('app_seller_products_archive', {id: product.id}) }}"
                                              style="display:inline;"
                                              onsubmit="return confirm('Убрать товар в архив?');">
                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('product_archive_' ~ product.id) }}">
                                            <button class="btn-icon" type="submit" title="В архив">
                                                <i class="bi bi-archive"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="clients-empty">
                                <i class="bi bi-box"></i>
                                <p>Товаров пока нет</p>
                                <span>Добавьте первый товар</span>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="clients-pagination">
                <span>Показано {{ pagination|length }} из {{ pagination.totalItemCount }}</span>
                {{ knp_pagination_render(pagination, 'admin/_pagination.html.twig') }}
            </div>
        {% endif %}
    </div>
{% endblock %}
