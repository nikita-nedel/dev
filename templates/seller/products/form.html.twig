{% extends 'seller/layout.html.twig' %}

{% block title %}{{ product ? 'Редактирование товара' : 'Новый товар' }}{% endblock %}
{% block page_title %}{{ product ? 'Редактирование товара' : 'Новый товар' }}{% endblock %}

{% block seller_body %}
    <div class="admin-panel">
        <div class="admin-panel-header">
            <h2>{{ product ? 'Карточка товара' : 'Добавление товара' }}</h2>
            <a href="{{ path('app_seller_products') }}" class="btn-admin-outline btn-sm"><i class="bi bi-arrow-left"></i> Назад</a>
        </div>

        <form method="post" enctype="multipart/form-data" action="{{ product ? path('app_seller_products_edit', {id: product.id}) : path('app_seller_products_new') }}" class="admin-form">
            <div class="admin-form-grid">
                <div class="form-group" style="grid-column: 1 / -1;">
                    <label class="form-label" for="product-name">Название</label>
                    <input class="admin-input" id="product-name" name="name" value="{{ product.name|default('') }}" placeholder="Например, хлопковая футболка oversize" required>
                </div>
                <div class="form-group">
                    <label class="form-label" for="product-sku">Артикул (SKU)</label>
                    <input class="admin-input" id="product-sku" name="sku" value="{{ product.sku|default('') }}" placeholder="CL-001" required>
                </div>
                <div class="form-group">
                    <label class="form-label" for="product-category">Категория</label>
                    <select class="admin-select" id="product-category" name="category">
                        {% for category in categories %}
                            <option value="{{ category.id }}" {{ product and product.category and product.category.id == category.id ? 'selected' : '' }}>{{ category.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-group" style="grid-column: 1 / -1;">
                    <label class="form-label" for="product-description">Описание</label>
                    <textarea class="admin-input" id="product-description" name="description" rows="4">{{ product.description|default('') }}</textarea>
                </div>
                <div class="form-group">
                    <label class="form-label" for="product-price">Цена, ₽</label>
                    <input class="admin-input" id="product-price" name="price" type="number" step="0.01" value="{{ product.price|default('') }}" placeholder="0">
                </div>
                <div class="form-group">
                    <label class="form-label" for="product-stock">Остаток</label>
                    <input class="admin-input" id="product-stock" name="stock" type="number" value="{{ product.stock|default('') }}" placeholder="0">
                </div>
                <div class="form-group">
                    <label class="form-label" for="product-active">Статус</label>
                    <select class="admin-select" id="product-active" name="active">
                        <option value="1" {{ product is null or product.active ? 'selected' : '' }}>Активен</option>
                        <option value="0" {{ product and not product.active ? 'selected' : '' }}>Неактивен</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="product-image">Изображение</label>
                    <input class="admin-input" id="product-image" name="image" type="file" accept="image/*">
                </div>
            </div>

            <div class="admin-form-actions">
                <button class="btn-admin-primary" type="submit">Сохранить</button>
                <a class="btn-admin-outline" href="{{ path('app_seller_products') }}">Отмена</a>
            </div>
        </form>
    </div>
{% endblock %}
