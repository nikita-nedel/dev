{% extends 'seller/layout.html.twig' %}

{% block title %}{{ product ? 'Редактирование товара' : 'Новый товар' }}{% endblock %}
{% block page_title %}{{ product ? 'Редактирование товара' : 'Новый товар' }}{% endblock %}

{% block seller_body %}
    <div class="admin-panel">
        <div class="admin-panel-header">
            <h2>{{ product ? 'Карточка товара' : 'Добавление товара' }}</h2>
            <a href="{{ path('app_seller_products') }}" class="btn-admin-outline btn-sm">
                <i class="bi bi-arrow-left"></i> Назад
            </a>
        </div>

        {{ form_start(form, {attr: {class: 'admin-form'}}) }}
        <div style="padding: 1.25rem 1.5rem;">
            {{ form_errors(form) }}
            <div class="admin-form-grid">
                <div class="form-group">{{ form_row(form.shop) }}</div>
                <div class="form-group">{{ form_row(form.category) }}</div>
                <div class="form-group">{{ form_row(form.name) }}</div>
                <div class="form-group">
                    {{ form_label(form.sku) }}
                    <div style="display: flex; gap: 0.5rem; align-items: stretch;">
                        {{ form_widget(form.sku) }}
                        <button type="button"
                                id="generate-sku"
                                class="btn-admin-outline btn-sm"
                                style="white-space: nowrap;"
                                data-url="{{ path('app_seller_products_generate_sku') }}">
                            <i class="bi bi-shuffle"></i> Сгенерировать
                        </button>
                    </div>
                    {{ form_errors(form.sku) }}
                </div>
                <div class="form-group">{{ form_row(form.price) }}</div>
                <div class="form-group" style="grid-column: 1 / -1;">
                    {{ form_row(form.description) }}
                </div>
            </div>
        </div>
        <div class="admin-form-actions">
            <button class="btn-admin-primary" type="submit">Сохранить</button>
            <a class="btn-admin-outline" href="{{ path('app_seller_products') }}">Отмена</a>
        </div>
        {{ form_end(form) }}
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const button = document.getElementById('generate-sku');
            const input = document.querySelector('input[name="product_form[sku]"]');
            const shop = document.querySelector('select[name^="product_form[shop"]');

            if (!button || !input || !shop) {
                return;
            }

            button.addEventListener('click', async function () {
                button.disabled = true;

                try {
                    const url = new URL(button.dataset.url, window.location.origin);
                    url.searchParams.set('shopId', shop.value);

                    const response = await fetch(url, {
                        headers: {'X-Requested-With': 'XMLHttpRequest'},
                    });

                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }

                    const data = await response.json();
                    input.value = data.sku;
                    input.dispatchEvent(new Event('input', {bubbles: true}));
                } catch (error) {
                    window.alert('Не удалось сгенерировать артикул. Попробуйте ещё раз.');
                } finally {
                    button.disabled = false;
                }
            });
        });
    </script>
{% endblock %}
