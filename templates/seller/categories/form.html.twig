{% extends 'seller/layout.html.twig' %}

{% block title %}{{ category.id ? 'Редактирование категории' : 'Новая категория' }}{% endblock %}
{% block page_title %}{{ category.id ? 'Редактирование категории' : 'Создание категории' }}{% endblock %}

{% block seller_body %}
    <div class="admin-panel">
        <div class="admin-panel-header">
            <h2>{{ category.id ? 'Редактировать' : 'Создать' }} категорию</h2>
            <a href="" class="btn-admin-outline btn-sm"><i class="bi bi-arrow-left"></i> Назад</a>
        </div>

        <form method="post" action="" class="admin-auth-form" style="padding: 1.5rem;">
            <div style="max-width: 500px;">
                <div class="form-group">
                    <label>Название</label>
                    <input type="text" name="category[name]" value="{{ category.name }}" class="admin-input" placeholder="Введите название категории" required>
                </div>
                <div class="form-group">
                    <label>Родительская категория</label>
                    <select name="category[parent]" class="admin-select">
                        <option value="">— Без родителя —</option>
                        {% for parent in categories %}
                            <option value="{{ parent.id }}" {% if category.parent and category.parent.id == parent.id %}selected{% endif %}>{{ parent.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
                    <button type="submit" class="btn-admin-primary">Сохранить</button>
                    <a href="" class="btn-admin-outline">Отмена</a>
                </div>
            </div>
            {{ form_rest(form) }}
        </form>
    </div>
{% endblock %}