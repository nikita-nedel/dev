{% extends 'base.html.twig' %}

{% block title %}Корзина — WB Style{% endblock %}
{% block body_class %}wb-storefront has-mobile-cart{% endblock %}

{% block body %}
    {% set cartUnits = 0 %}
    {% for item in cartItems %}{% set cartUnits = cartUnits + item.quantity %}{% endfor %}
    <div class="wb-page-head">
        <div class="container">
            <nav class="wb-breadcrumbs" aria-label="Хлебные крошки">
                <a href="{{ path('app_home') }}">Главная</a>
                <span class="sep">/</span>
                <span aria-current="page">Корзина</span>
            </nav>
            <div class="wb-page-title-row">
                <div>
                    <h1>Корзина <span class="wb-count-chip" data-cart-title>{{ cartUnits }} {{ cartUnits == 1 ? 'товар' : (cartUnits < 5 ? 'товара' : 'товаров') }}</span></h1>
                    <p>Проверьте размеры и количество — всё можно изменить перед оформлением.</p>
                </div>
                <a class="wb-link" href="{{ path('cat') }}">Продолжить покупки <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <div class="container cart-layout">
        <section class="cart-main" aria-labelledby="cart-title">
            <h2 class="visually-hidden" id="cart-title">Товары в корзине</h2>
            <div class="cart-toolbar">
                <label class="cart-check">
                    <input type="checkbox" checked data-select-all>
                    Выбрать все
                </label>
                <span class="cart-toolbar__label" data-selected-label>Выбрано {{ cartItems|length }} из {{ cartItems|length }}</span>
                <button class="cart-toolbar__remove" type="button" data-remove-selected>Удалить выбранное</button>
            </div>

            <div class="cart-card" data-cart-list>
                {% for item in cartItems %}
                    {% set product = item.product %}
                    <article class="cart-item" data-price="{{ product.price }}" data-qty="{{ item.quantity }}">
                        <input class="cart-item__check" type="checkbox" checked aria-label="Выбрать «{{ product.name }}»" data-item-check style="width: 15px; height: 15px; margin-top: 3px; accent-color: var(--wb-petrol);">
                        <a class="cart-item__image" href="{{ path('app_product_show', {id: product.id}) }}">
                            <img src="{{ product.image }}" alt="{{ product.name }}">
                        </a>
                        <div class="cart-item__body">
                            <div class="cart-item__head">
                                <div>
                                    <a class="cart-item__seller" href="{{ path('cat') }}">
                                        <span class="cart-item__mark">{{ product.sellerName|first|upper }}</span>
                                        {{ product.sellerName }}
                                        <i class="bi bi-patch-check" style="color: var(--wb-green);"></i>
                                    </a>
                                    <h3 class="cart-item__name"><a href="{{ path('app_product_show', {id: product.id}) }}">{{ product.name }}</a></h3>
                                    <p class="cart-item__meta">
                                        <span>Размер {{ item.size }}</span><span>·</span>
                                        <span>{{ item.color }}</span><span>·</span>
                                        <span style="color: var(--wb-green);">В наличии</span>
                                    </p>
                                </div>
                                <button class="cart-item__remove" type="button" aria-label="Удалить товар" data-remove>
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                            <div class="cart-item__bottom">
                                <div class="cart-item__extra">
                                    <button class="cart-fav" type="button" aria-pressed="false" data-wb-favorite>
                                        <i class="bi bi-heart"></i><span>В избранное</span>
                                    </button>
                                    <span class="cart-item__delivery"><i class="bi bi-truck"></i>Завтра, 19 ноября</span>
                                </div>
                                <div class="cart-item__side">
                                    <div class="qty" role="group" aria-label="Количество">
                                        <button type="button" data-minus aria-label="Уменьшить количество"><i class="bi bi-dash"></i></button>
                                        <span data-qty>{{ item.quantity }}</span>
                                        <button type="button" data-plus aria-label="Увеличить количество"><i class="bi bi-plus"></i></button>
                                    </div>
                                    <div class="cart-item__price">
                                        <strong data-line-total>{{ (product.price * item.quantity)|number_format(0, ',', ' ') }} ₽</strong>
                                        {% if product.oldPrice %}
                                            <s>{{ product.oldPrice|number_format(0, ',', ' ') }} ₽</s>
                                            <small>−{{ product.discount }}%</small>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>

            <div class="wb-empty" hidden data-cart-empty>
                <span class="wb-empty__icon"><i class="bi bi-bag"></i></span>
                <h2>В корзине пока пусто</h2>
                <p>Добавьте что-нибудь из новой коллекции — мы сохраним выбор.</p>
                <a class="btn btn-primary" href="{{ path('cat') }}">Перейти в каталог <i class="bi bi-arrow-right"></i></a>
            </div>

            <div class="cart-assurance">
                <div><i class="bi bi-truck"></i><span><strong>Бесплатно</strong> от 3 000 ₽</span></div>
                <div><i class="bi bi-arrow-counterclockwise"></i><span><strong>14 дней</strong> на возврат</span></div>
                <div><i class="bi bi-shield-check"></i><span><strong>Безопасная</strong> оплата</span></div>
            </div>
        </section>

        <aside class="cart-aside" aria-label="Итог заказа">
            <section class="cart-summary">
                <div class="cart-summary__head">
                    <h2>Ваш заказ</h2>
                    <span data-summary-count>{{ cartUnits }} {{ cartUnits == 1 ? 'товар' : (cartUnits < 5 ? 'товара' : 'товаров') }}</span>
                </div>
                <div class="cart-summary__rows">
                    <div class="cart-summary__row"><span>Товары</span><strong data-subtotal>{{ subtotal|number_format(0, ',', ' ') }} ₽</strong></div>
                    <div class="cart-summary__row cart-summary__row--green" data-discount-row><span>Скидка WB Style</span><strong data-discount>−{{ discount|number_format(0, ',', ' ') }} ₽</strong></div>
                    <div class="cart-summary__row cart-summary__row--promo" hidden data-promo-row>
                        <span>Промокод WELCOME</span><strong data-promo-value>−1 000 ₽</strong>
                        <button type="button" aria-label="Убрать промокод" data-promo-remove>×</button>
                    </div>
                    <div class="cart-summary__row"><span>Доставка</span><strong data-delivery-value>{{ delivery == 0 ? 'Бесплатно' : delivery|number_format(0, ',', ' ') ~ ' ₽' }}</strong></div>
                </div>
                <div class="cart-summary__total"><span>К оплате</span><strong data-total aria-live="polite">{{ total|number_format(0, ',', ' ') }} ₽</strong></div>
                <p class="cart-summary__bonus"><i class="bi bi-stars"></i> Начислим <strong data-bonus>{{ (total * 0.05)|round|number_format(0, ',', ' ') }} бонусов</strong></p>
                <button class="btn btn-primary checkout" type="button" data-checkout>Оформить заказ <i class="bi bi-arrow-right"></i></button>
                <p class="cart-summary__secure"><i class="bi bi-lock"></i> Безопасная оплата</p>

                <div class="cart-promo">
                    <label for="promo-code">Промокод</label>
                    <div class="cart-promo__row">
                        <input id="promo-code" type="text" placeholder="Введите код" autocomplete="off">
                        <button type="button" data-promo-apply>Применить</button>
                    </div>
                    <p class="cart-promo__hint">Попробуйте <strong>WELCOME</strong> — минус 1 000 ₽</p>
                </div>
            </section>

            <section class="cart-delivery">
                <div class="cart-delivery__head">
                    <h2>Доставка</h2>
                    <button type="button" data-wb-demo="Выбор пункта выдачи">Изменить</button>
                </div>
                <div class="cart-delivery__row">
                    <i class="bi bi-geo-alt"></i>
                    <div><strong>Санкт-Петербург, ул. Лесная, 7</strong><span>ПВЗ WB Style · 5 минут пешком</span></div>
                </div>
                <div class="cart-delivery__row">
                    <i class="bi bi-calendar-check"></i>
                    <div><strong>Завтра, 19 ноября</strong><span>Можно забрать после 14:00</span></div>
                </div>
                <div class="cart-delivery__row">
                    <i class="bi bi-credit-card"></i>
                    <div><strong>Оплата картой онлайн</strong><span>Или при получении — на ваш выбор</span></div>
                </div>
            </section>

            <div class="cart-help">
                <span class="cart-help__icon"><i class="bi bi-question-circle"></i></span>
                <div>
                    <strong>Нужна помощь с заказом?</strong>
                    <p>Подскажем по размерам и доставке — отвечаем в течение 15 минут.</p>
                    <a href="#" data-wb-demo="Чат поддержки">Написать в чат</a>
                </div>
            </div>
        </aside>
    </div>

    <div class="cart-mobile-bar">
        <div><span data-mobile-label>Выбрано {{ cartItems|length }} товара</span><strong data-total>{{ total|number_format(0, ',', ' ') }} ₽</strong></div>
        <button class="btn btn-primary" type="button" data-checkout>Оформить заказ</button>
    </div>
{% endblock %}

{% block extra_javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const list = document.querySelector('[data-cart-list]');
            if (!list) return;
            const empty = document.querySelector('[data-cart-empty]');
            const toolbar = document.querySelector('.cart-toolbar');
            const selectAll = document.querySelector('[data-select-all]');
            const promoInput = document.querySelector('#promo-code');
            const promoRow = document.querySelector('[data-promo-row]');
            const state = { promo: 0 };
            const discountRate = {{ subtotal > 0 ? (discount / subtotal) : 0 }};

            const money = (value) => `${new Intl.NumberFormat('ru-RU').format(Math.round(value))} ₽`;
            const plural = (n, one, few, many) => {
                const m10 = n % 10;
                const m100 = n % 100;
                if (m10 === 1 && m100 !== 11) return one;
                if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return few;
                return many;
            };

            const items = () => [...list.querySelectorAll('.cart-item')];

            function recalc() {
                const all = items();
                let units = 0;
                let selected = 0;
                let subtotal = 0;

                all.forEach((item) => {
                    const qty = Number(item.dataset.qty);
                    const line = Number(item.dataset.price) * qty;
                    const checked = item.querySelector('[data-item-check]').checked;
                    item.querySelector('[data-qty]').textContent = qty;
                    item.querySelector('[data-line-total]').textContent = money(line);
                    item.classList.toggle('is-unselected', !checked);
                    item.querySelector('[data-minus]').disabled = qty <= 1;
                    units += qty;
                    if (checked) {
                        selected += 1;
                        subtotal += line;
                    }
                });

                const discount = Math.round(subtotal * discountRate);
                const delivery = subtotal === 0 || subtotal >= 3000 ? 0 : 490;
                const total = Math.max(0, subtotal - discount - state.promo + delivery);

                if (all.length === 0) {
                    state.promo = 0;
                    if (promoRow) promoRow.hidden = true;
                }

                document.querySelector('[data-subtotal]').textContent = money(subtotal);
                document.querySelector('[data-discount]').textContent = `−${money(discount)}`;
                document.querySelector('[data-discount-row]').hidden = subtotal === 0;
                document.querySelector('[data-delivery-value]').textContent = delivery === 0 ? 'Бесплатно' : money(delivery);
                document.querySelectorAll('[data-total]').forEach((element) => { element.textContent = money(total); });
                document.querySelector('[data-bonus]').textContent = `${new Intl.NumberFormat('ru-RU').format(Math.round(total * 0.05))} бонусов`;
                document.querySelector('[data-cart-title]').textContent = `${units} ${plural(units, 'товар', 'товара', 'товаров')}`;
                document.querySelector('[data-summary-count]').textContent = `${units} ${plural(units, 'товар', 'товара', 'товаров')}`;
                document.querySelector('[data-selected-label]').textContent = `Выбрано ${selected} из ${all.length}`;
                document.querySelector('[data-mobile-label]').textContent = `Выбрано ${selected} ${plural(selected, 'товар', 'товара', 'товаров')}`;
                document.querySelectorAll('[data-checkout]').forEach((button) => { button.disabled = selected === 0; });

                if (selectAll) {
                    selectAll.checked = all.length > 0 && selected === all.length;
                    selectAll.indeterminate = selected > 0 && selected < all.length;
                }

                const isEmpty = all.length === 0;
                empty.hidden = !isEmpty;
                list.hidden = isEmpty;
                toolbar.hidden = isEmpty;
            }

            list.addEventListener('click', (event) => {
                const plus = event.target.closest('[data-plus]');
                const minus = event.target.closest('[data-minus]');
                if (!plus && !minus) return;
                const item = event.target.closest('.cart-item');
                const qty = Number(item.dataset.qty);
                item.dataset.qty = String(Math.max(1, Math.min(9, qty + (plus ? 1 : -1))));
                recalc();
            });

            list.addEventListener('change', (event) => {
                if (event.target.matches('[data-item-check]')) recalc();
            });

            selectAll?.addEventListener('change', () => {
                list.querySelectorAll('[data-item-check]').forEach((box) => { box.checked = selectAll.checked; });
                recalc();
            });

            list.addEventListener('click', (event) => {
                const button = event.target.closest('[data-remove]');
                if (!button) return;
                button.closest('.cart-item').remove();
                recalc();
                window.showToast?.('Товар удалён из корзины', 'success');
            });

            document.querySelector('[data-remove-selected]')?.addEventListener('click', () => {
                const selected = items().filter((item) => item.querySelector('[data-item-check]').checked);
                if (!selected.length) {
                    window.showToast?.('Выберите товары для удаления', 'error');
                    return;
                }
                selected.forEach((item) => item.remove());
                recalc();
                window.showToast?.('Выбранные товары удалены', 'success');
            });

            document.querySelector('[data-promo-apply]')?.addEventListener('click', () => {
                const code = (promoInput?.value || '').trim().toUpperCase();
                if (code === 'WELCOME') {
                    state.promo = 1000;
                    promoRow.hidden = false;
                    document.querySelector('[data-promo-value]').textContent = '−1 000 ₽';
                    recalc();
                    window.showToast?.('Промокод WELCOME применён', 'success');
                } else {
                    window.showToast?.(code ? 'Промокод не найден' : 'Введите промокод', 'error');
                }
            });

            document.querySelector('[data-promo-remove]')?.addEventListener('click', () => {
                state.promo = 0;
                promoRow.hidden = true;
                promoInput.value = '';
                recalc();
                window.showToast?.('Промокод убран');
            });

            document.querySelectorAll('[data-checkout]').forEach((button) => {
                button.addEventListener('click', () => {
                    const selected = items().filter((item) => item.querySelector('[data-item-check]').checked).length;
                    if (!selected) {
                        window.showToast?.('Выберите хотя бы один товар', 'error');
                        return;
                    }
                    window.showToast?.('Заказ оформлен — это демо-версия', 'success');
                });
            });

            recalc();
        });
    </script>
{% endblock %}
