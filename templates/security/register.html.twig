{% extends 'base.html.twig' %}

{% block title %}Регистрация — WB Style{% endblock %}

{% block body %}
    <main class="auth-page">
        <div class="container">
            <div class="auth-shell">
                <aside class="auth-aside">
                    <div>
                        <span class="auth-aside__eyebrow">WB Style · покупателям</span>
                        <h2>Соберите свой город</h2>
                        <p>Создайте аккаунт, чтобы сохранять избранное, быстрее оформлять заказы и получать бонусы.</p>
                        <div class="auth-features">
                            <div class="auth-feature"><i class="bi bi-percent"></i><span>Скидки для своих — до 30%</span></div>
                            <div class="auth-feature"><i class="bi bi-heart"></i><span>Избранное и подборки</span></div>
                            <div class="auth-feature"><i class="bi bi-bell"></i><span>Статусы заказов и новинки</span></div>
                        </div>
                    </div>
                    <div class="auth-aside__stats">
                        <div><strong>1 200+</strong><span>продавцов</span></div>
                        <div><strong>2 400+</strong><span>товаров</span></div>
                        <div><strong>14 дней</strong><span>на возврат</span></div>
                    </div>
                </aside>

                <div class="auth-form-side">
                    <div class="auth-form-wrap">
                        <a class="auth-brand" href="{{ path('app_home') }}">
                            <span class="wb-brand__mark">W</span>
                            <span class="wb-brand__name">WB <span>Style</span></span>
                        </a>

                        <div class="auth-header">
                            <h1>Создать аккаунт</h1>
                            <p>Это займёт меньше минуты.</p>
                        </div>

                        {{ form_start(registrationForm, {attr: {class: 'auth-form'}}) }}
                            {{ form_errors(registrationForm) }}

                            <div class="auth-row">
                                <div class="form-group">
                                    {{ form_label(registrationForm.firstName, 'Имя', {label_attr: {class: 'form-label'}}) }}
                                    {{ form_widget(registrationForm.firstName, {attr: {class: 'form-control'}}) }}
                                    {{ form_errors(registrationForm.firstName) }}
                                </div>
                                <div class="form-group">
                                    {{ form_label(registrationForm.lastName, 'Фамилия', {label_attr: {class: 'form-label'}}) }}
                                    {{ form_widget(registrationForm.lastName, {attr: {class: 'form-control'}}) }}
                                    {{ form_errors(registrationForm.lastName) }}
                                </div>
                            </div>

                            <div class="form-group">
                                {{ form_label(registrationForm.phone, 'Телефон', {label_attr: {class: 'form-label'}}) }}
                                {{ form_widget(registrationForm.phone, {attr: {class: 'form-control'}}) }}
                                {{ form_errors(registrationForm.phone) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(registrationForm.email, 'E-mail', {label_attr: {class: 'form-label'}}) }}
                                {{ form_widget(registrationForm.email, {attr: {class: 'form-control'}}) }}
                                {{ form_errors(registrationForm.email) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(registrationForm.plainPassword, 'Пароль', {label_attr: {class: 'form-label'}}) }}
                                <div class="auth-input-wrap">
                                    {{ form_widget(registrationForm.plainPassword, {attr: {class: 'form-control'}}) }}
                                    <button class="auth-eye" type="button" aria-label="Показать пароль" data-toggle-password="#{{ registrationForm.plainPassword.vars.id }}">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                {{ form_errors(registrationForm.plainPassword) }}
                            </div>

                            <button class="btn btn-primary auth-submit" type="submit">Зарегистрироваться <i class="bi bi-arrow-right"></i></button>

                            <p class="auth-note">Создавая аккаунт, вы соглашаетесь с офертой и политикой конфиденциальности.</p>
                            <div class="auth-alt">Уже есть аккаунт? <a href="{{ path('app_login') }}">Войти</a></div>
                        {{ form_end(registrationForm) }}
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
