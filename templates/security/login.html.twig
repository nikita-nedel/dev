{% extends 'base.html.twig' %}

{% block title %}Вход в аккаунт — WB Style{% endblock %}

{% block body %}
    <main class="auth-page">
        <div class="container">
            <div class="auth-shell">
                <aside class="auth-aside">
                    <div>
                        <span class="auth-aside__eyebrow">WB Style · покупателям</span>
                        <h2>С возвращением в город</h2>
                        <p>Войдите, чтобы проверить заказы, сохранить избранное и получать персональные подборки.</p>
                        <div class="auth-features">
                            <div class="auth-feature"><i class="bi bi-truck"></i><span>Доставка от одного дня</span></div>
                            <div class="auth-feature"><i class="bi bi-shield-check"></i><span>Безопасная оплата и возврат</span></div>
                            <div class="auth-feature"><i class="bi bi-stars"></i><span>Бонусы за каждую покупку</span></div>
                        </div>
                    </div>
                    <div class="auth-aside__stats">
                        <div><strong>10K+</strong><span>покупателей</span></div>
                        <div><strong>4.8</strong><span>средний рейтинг</span></div>
                        <div><strong>24/7</strong><span>поддержка</span></div>
                    </div>
                </aside>

                <div class="auth-form-side">
                    <div class="auth-form-wrap">
                        <a class="auth-brand" href="{{ path('app_home') }}">
                            <span class="wb-brand__mark">W</span>
                            <span class="wb-brand__name">WB <span>Style</span></span>
                        </a>

                        <div class="auth-header">
                            <h1>Вход в аккаунт</h1>
                            <p>Введите e-mail и пароль, чтобы продолжить.</p>
                        </div>

                        {% if error %}
                            <div class="auth-alert" role="alert">
                                <i class="bi bi-exclamation-circle me-1"></i>
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>
                        {% endif %}

                        <form method="post" action="{{ path('app_login') }}" class="auth-form">
                            <div class="form-group">
                                <label class="form-label" for="username"><i class="bi bi-envelope"></i> E-mail</label>
                                <input type="email" id="username" name="_username" value="{{ last_username }}"
                                       class="form-control" placeholder="your@email.com" autocomplete="email" required autofocus>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="password"><i class="bi bi-lock"></i> Пароль</label>
                                <div class="auth-input-wrap">
                                    <input type="password" id="password" name="_password" class="form-control"
                                           placeholder="Введите пароль" autocomplete="current-password" required>
                                    <button class="auth-eye" type="button" aria-label="Показать пароль" data-toggle-password="#password">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="auth-meta">
                                <label class="auth-check"><input type="checkbox" name="_remember_me"> Запомнить меня</label>
                                <a href="#" data-wb-demo="Восстановление пароля">Забыли пароль?</a>
                            </div>

                            <button class="btn btn-primary auth-submit" type="submit">Войти <i class="bi bi-arrow-right"></i></button>

                            <div class="auth-divider">или</div>

                            <div class="auth-alt">Нет аккаунта? <a href="{{ path('app_register') }}">Зарегистрироваться</a></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
