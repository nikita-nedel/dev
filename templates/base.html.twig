<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#27373e">
    <title>{% block title %}WB Style{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>

<body class="{% block body_class %}wb-storefront{% endblock %}">
<a class="skip-link" href="#main-content">Перейти к содержанию</a>

{% block header %}
    {{ include('components/header.html.twig') }}
{% endblock %}

{% set flashes = app.flashes %}
{% if flashes|length %}
    <div class="wb-flashes">
        {% for type, messages in flashes %}
            {% for message in messages %}
                <div class="wb-flash wb-flash--{{ type == 'error' ? 'error' : (type == 'success' ? 'success' : 'info') }}" role="status">
                    <i class="bi {{ type == 'error' ? 'bi-exclamation-circle' : (type == 'success' ? 'bi-check-circle' : 'bi-info-circle') }}"></i>
                    <span>{{ message }}</span>
                    <button class="wb-flash__close" type="button" aria-label="Закрыть" data-wb-flash-close>&times;</button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}

<main id="main-content">
    {% block body %}{% endblock %}
</main>

{% block footer %}
    {{ include('components/footer.html.twig') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}

{% block extra_javascripts %}{% endblock %}
</body>
</html>
