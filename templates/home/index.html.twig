{% extends 'base.html.twig' %}

{% block title %}WB Style — городской маркетплейс{% endblock %}

{% block body %}
    <section class="home-hero">
        <div class="container">
            <div class="home-hero__grid">
                <article class="home-hero__main">
                    <img src="{{ slides[0].image }}" alt="{{ slides[0].title }}" fetchpriority="high">
                    <div class="home-hero__content">
                        <span class="wb-eyebrow">{{ slides[0].title }} · {{ 'now'|date('Y') }}</span>
                        <h1>Городской гардероб без лишнего шума</h1>
                        <p>{{ slides[0].description }}. Спокойные оттенки, честные материалы и проверенные продавцы — более 2 000 вещей с доставкой от одного дня.</p>
                        <div class="home-hero__actions">
                            <a class="btn btn-light" href="{{ slides[0].link }}">Смотреть коллекцию</a>
                            <a class="btn btn-outline-light" href="#" data-wb-demo="Страница о проверке продавцов">Как мы проверяем</a>
                        </div>
                        <div class="home-hero__stats">
                            <div><strong>2 400+</strong><span>вещей в каталоге</span></div>
                            <div><strong>1 200</strong><span>продавцов</span></div>
                            <div><strong>4.8</strong><span>средний рейтинг</span></div>
                        </div>
                    </div>
                </article>

                <div class="home-hero__side">
                    <article class="home-promo home-promo--sale">
                        <div>
                            <span class="home-promo__label">Распродажа недели</span>
                            <div class="home-promo__value">−40%</div>
                            <h2>На вторую вещь</h2>
                            <p>В категориях «Одежда» и «Обувь» до 30 ноября.</p>
                        </div>
                        <a class="btn btn-outline-light" href="{{ path('cat', {slug: 'odezhda'}) }}">К распродаже <i class="bi bi-arrow-right"></i></a>
                    </article>
                    <article class="home-promo home-promo--seller">
                        <div>
                            <span class="home-promo__label">Продавцам</span>
                            <h2>Откройте магазин<br>за 10 минут</h2>
                            <p>1 200+ магазинов уже продают на WB Style. Выплаты раз в неделю.</p>
                        </div>
                        <a class="btn btn-outline-light" href="{{ path('seller_apply') }}">Начать продавать <i class="bi bi-arrow-right"></i></a>
                    </article>
                </div>
            </div>

            <div class="home-benefits">
                <div class="home-benefit">
                    <span class="home-benefit__icon"><i class="bi bi-truck"></i></span>
                    <div><strong>Доставка от 1 дня</strong><span>Курьер и 8 400 пунктов</span></div>
                </div>
                <div class="home-benefit">
                    <span class="home-benefit__icon"><i class="bi bi-shield-check"></i></span>
                    <div><strong>Проверенные продавцы</strong><span>Документы и рейтинг</span></div>
                </div>
                <div class="home-benefit">
                    <span class="home-benefit__icon"><i class="bi bi-credit-card"></i></span>
                    <div><strong>Оплата частями</strong><span>0% на 4 платежа</span></div>
                </div>
                <div class="home-benefit">
                    <span class="home-benefit__icon"><i class="bi bi-arrow-counterclockwise"></i></span>
                    <div><strong>Возврат 14 дней</strong><span>Без объяснения причин</span></div>
                </div>
            </div>
        </div>
    </section>

    <section class="categories-section" aria-labelledby="home-categories-title">
        <div class="container">
            <div class="categories-head">
                <h2 id="home-categories-title">Категории</h2>
                <a class="wb-link" href="{{ path('cat') }}">Все категории <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="cat-grid">
                {% for category in categories %}
                    <a class="cat-tile" href="{{ path('cat', {slug: category.slug}) }}">
                        <span class="cat-tile__icon"><i class="bi {{ category.icon }}"></i></span>
                        <strong>{{ category.name }}</strong>
                        <span>{{ category.count|number_format(0, ',', ' ') }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="home-products" aria-labelledby="home-products-title">
        <div class="container">
            <div class="wb-section-head">
                <div>
                    <span class="wb-eyebrow">Каталог</span>
                    <h2 id="home-products-title">Хиты недели</h2>
                    <p>Подборка обновляется каждый понедельник</p>
                </div>
                <div class="home-products-tools">
                    <label class="sort-control">Сортировка
                        <select aria-label="Сортировка товаров">
                            <option>По популярности</option>
                            <option>Сначала дешевле</option>
                            <option>Сначала дороже</option>
                            <option>По рейтингу</option>
                        </select>
                    </label>
                    <a class="wb-link" href="{{ path('cat') }}">Все товары <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>

            <div class="product-grid">
                {% for product in products|slice(0, 8) %}
                    {{ include('components/product_card.html.twig') }}
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="wb-section sellers-section" aria-labelledby="home-sellers-title">
        <div class="container">
            <div class="wb-section-head">
                <div>
                    <span class="wb-eyebrow">Продавцы</span>
                    <h2 id="home-sellers-title">Магазины с высоким рейтингом</h2>
                    <p>Проверяем документы, ассортимент и сроки отправки</p>
                </div>
                <a class="wb-link" href="#" data-wb-demo="Каталог продавцов">Все продавцы <i class="bi bi-arrow-right"></i></a>
            </div>

            <div class="seller-grid">
                {% for seller in sellers %}
                    <article class="seller-card">
                        <div class="seller-card__head">
                            <span class="seller-card__logo">{{ seller.name|split(' ')|first|first|upper }}{{ seller.name|split(' ')|last|first|upper }}</span>
                            <div>
                                <h3 class="seller-card__name">{{ seller.name }}</h3>
                                <p class="seller-card__meta">{{ seller.city }} · с {{ seller.since }}</p>
                            </div>
                            <span class="seller-card__badge"><i class="bi bi-check-lg"></i>Проверен</span>
                        </div>
                        <div class="seller-stats">
                            <div><strong>{{ seller.rating }}</strong><span>рейтинг</span></div>
                            <div><strong>{{ seller.count }}</strong><span>товаров</span></div>
                            <div><strong>1–2 дня</strong><span>отправка</span></div>
                        </div>
                        <a class="btn btn-outline-primary" href="{{ path('cat') }}">В магазин</a>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="become-section" aria-labelledby="become-title">
        <div class="container">
            <div class="become-card">
                <div>
                    <span class="wb-eyebrow">Продавцам</span>
                    <h2 id="become-title">Продавайте там, где вас ищут</h2>
                    <p>Подключите магазин за 10 минут: загрузите товары, выберите склад и начните принимать заказы. Комиссия — от 7%, выплаты каждую неделю.</p>
                    <a class="btn btn-light" href="{{ path('seller_apply') }}">Открыть магазин <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="become-stats">
                    <div class="become-stat"><strong>1 200+</strong><span>активных магазинов</span></div>
                    <div class="become-stat"><strong>7%</strong><span>комиссия от</span></div>
                    <div class="become-stat"><strong>7 дней</strong><span>цикл выплат</span></div>
                </div>
            </div>
        </div>
    </section>

    <section class="subscribe-strip" aria-labelledby="subscribe-title">
        <div class="container subscribe-strip__inner">
            <div>
                <h2 id="subscribe-title">Новинки и закрытые распродажи</h2>
                <p>Раз в неделю. Без спама, только полезное.</p>
            </div>
            <form data-wb-subscribe>
                <input type="email" name="email" placeholder="Ваш e-mail" aria-label="Ваш e-mail" required>
                <button type="submit">Подписаться</button>
            </form>
        </div>
    </section>
{% endblock %}
