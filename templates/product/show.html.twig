{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} — WB Style{% endblock %}

{% block body %}
    <div class="product-page">
        <div class="container">
            <nav class="wb-breadcrumbs" aria-label="Хлебные крошки">
                <a href="{{ path('app_home') }}">Главная</a>
                <span class="sep">/</span>
                <a href="{{ path('cat') }}">Каталог</a>
                <span class="sep">/</span>
                <span aria-current="page">{{ product.name }}</span>
            </nav>

            <div class="product-layout">
                <section class="product-gallery" aria-label="Фотографии товара">
                    <div class="product-gallery__main">
                        <img id="productMainImage" src="{{ product.images|first }}" alt="{{ product.name }}">
                    </div>
                    <div class="product-gallery__thumbs">
                        {% for image in product.images %}
                            <button class="product-thumb {{ loop.first ? 'is-active' : '' }}"
                                    type="button"
                                    data-product-thumb
                                    data-image="{{ image }}"
                                    aria-label="Фото {{ loop.index }}">
                                <img src="{{ image }}" alt="{{ product.name }} — фото {{ loop.index }}">
                            </button>
                        {% endfor %}
                    </div>
                </section>

                <aside class="product-panel">
                    <span class="product-category"><i class="bi bi-grid"></i>{{ product.category }}</span>
                    <h1>{{ product.name }}</h1>

                    <div class="product-rating">
                        <span><i class="bi bi-star-fill"></i> <strong>{{ product.rating }}</strong></span>
                        <span>· {{ product.reviews }} отзывов</span>
                    </div>

                    <div class="product-seller">
                        <i class="bi bi-shop"></i>
                        <span>{{ product.sellerName }}</span>
                        <strong><i class="bi bi-star-fill"></i> {{ product.sellerRating }}</strong>
                        <span class="seller-badge"><i class="bi bi-check-lg"></i> Проверен</span>
                    </div>

                    <div class="product-price-row">
                        <span class="product-price">{{ product.price|number_format(0, ',', ' ') }} ₽</span>
                        {% if product.oldPrice %}
                            <span class="product-old-price">{{ product.oldPrice|number_format(0, ',', ' ') }} ₽</span>
                            <span class="product-discount">−{{ product.discount }}%</span>
                        {% endif %}
                    </div>

                    {% if product.colors is not empty %}
                        <div class="product-option" data-option-group>
                            <div class="product-option__title">Цвет</div>
                            <div class="option-row">
                                {% for color in product.colors %}
                                    <button class="option-pill {{ loop.first ? 'is-active' : '' }}" type="button" data-option>{{ color }}</button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {% if product.sizes is not empty %}
                        <div class="product-option" data-option-group>
                            <div class="product-option__title">Размер</div>
                            <div class="option-row">
                                {% for size in product.sizes %}
                                    <button class="option-pill {{ loop.first ? 'is-active' : '' }}" type="button" data-option>{{ size }}</button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="product-buy">
                        <button class="btn btn-primary" type="button" data-wb-add-to-cart="{{ product.name }}">
                            <i class="bi bi-bag me-1"></i> Добавить в корзину
                        </button>
                        <button class="product-buy__fav {{ product.isFavorite ? 'is-active' : '' }}"
                                type="button"
                                aria-label="В избранное"
                                aria-pressed="{{ product.isFavorite ? 'true' : 'false' }}"
                                data-wb-favorite>
                            <i class="bi {{ product.isFavorite ? 'bi-heart-fill' : 'bi-heart' }}"></i>
                        </button>
                    </div>

                    <div class="delivery-list">
                        <div><i class="bi bi-truck"></i><span>Доставка завтра, бесплатно от 3 000 ₽</span></div>
                        <div><i class="bi bi-arrow-counterclockwise"></i><span>Возврат в течение 14 дней</span></div>
                        <div><i class="bi bi-shield-check"></i><span>Проверенный продавец WB Style</span></div>
                    </div>
                </aside>
            </div>

            <div class="product-details">
                <section class="wb-panel">
                    <h2>Описание</h2>
                    <p>{{ product.description }}</p>
                </section>
                <section class="wb-panel">
                    <h2>Особенности</h2>
                    <ul class="feature-list">
                        {% for feature in product.features %}
                            <li><i class="bi bi-check-circle-fill"></i>{{ feature }}</li>
                        {% endfor %}
                    </ul>
                </section>
            </div>

            <section class="related-section" aria-labelledby="related-title">
                <div class="wb-section-head">
                    <div>
                        <span class="wb-eyebrow">Подборка</span>
                        <h2 id="related-title">Похожие товары</h2>
                    </div>
                    <a class="wb-link" href="{{ path('cat') }}">Все товары <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="product-grid">
                    {% for item in relatedProducts %}
                        {{ include('components/product_card.html.twig', {product: item}) }}
                    {% endfor %}
                </div>
            </section>
        </div>
    </div>
{% endblock %}
